#!/bin/sh
# README.md. `fetch` moves the ~/.dotfiles git clone to the pinned commit, `run`
# runs its scripts/pod-bootstrap, no argument does both. Always exits 0: a failed
# bootstrap must not stop the pod's own program. Flux substitutes the two
# variables below; nothing else here may use braces.
set -u
ref=${DOTFILES_REF}
env=${DOTFILES_ENV}
dir="$HOME/.dotfiles"
url=https://github.com/h-wb/dotfiles.git

# A failed fetch keeps the commit already checked out (pod-bootstrap: `stale`).
fetch() {
	if [ ! -d "$dir/.git" ]; then
		timeout 300 git clone -q "$url" "$dir" || { echo "dotfiles: fetch failed: no clone at $dir"; return 1; }
	fi
	timeout 300 git -C "$dir" fetch -q origin "$ref" ||
		{ echo "dotfiles: fetch failed for $ref; keeping $(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"; return 1; }
	# Local changes go to a stash, not away: develop in ~/Repositories/dotfiles.
	if [ -n "$(git -C "$dir" status --porcelain)" ]; then
		git -C "$dir" -c user.name=dotfiles-bootstrap -c user.email=dotfiles-bootstrap@localhost \
			stash push -q -u -m "dotfiles-bootstrap: local changes before $ref" ||
			{ echo "dotfiles: fetch failed: could not stash local changes"; return 1; }
	fi
	git -C "$dir" checkout -q --force --detach "$ref" || { echo "dotfiles: fetch failed: checkout of $ref"; return 1; }
	echo "dotfiles: $ref at $dir"
}

run() {
	[ -f "$dir/scripts/pod-bootstrap" ] || { echo "dotfiles: no checkout at $dir; nothing to run"; return 1; }
	DOTFILES_REF="$ref" timeout 3300 sh "$dir/scripts/pod-bootstrap" "$env" ||
		echo "dotfiles: bootstrap did not complete; starting anyway"
}

case "$*" in
fetch) fetch ;;
run) run ;;
"") fetch; run ;;
*) echo "usage: dotfiles-bootstrap [fetch|run]" ;;
esac
exit 0
