#!/bin/sh
# README.md. `fetch` replaces ~/.dotfiles with the pinned commit, `run` runs its
# scripts/pod-bootstrap, no argument does both. Always exits 0: a failed
# bootstrap must not stop the pod's own program. Flux substitutes the two
# variables below; nothing else here may use braces.
set -u
ref=${DOTFILES_REF}
env=${DOTFILES_ENV}
dir="$HOME/.dotfiles"

fetch() {
	rm -rf "$dir.new" "$dir.old" "$dir.tar.gz"
	mkdir -p "$dir.new" &&
		curl -fsSL --retry 3 --max-time 300 -o "$dir.tar.gz" \
			"https://codeload.github.com/h-wb/dotfiles/tar.gz/$ref" &&
		tar -xzf "$dir.tar.gz" -C "$dir.new" --strip-components 1 &&
		[ -f "$dir.new/scripts/pod-bootstrap" ] &&
		echo "$ref" >"$dir.new/.pinned-commit" || {
		rm -rf "$dir.new" "$dir.tar.gz"
		echo "dotfiles: fetch failed for $ref; keeping the checkout already here"
		return 1
	}
	rm -f "$dir.tar.gz"
	# Once: a git clone from before the pin may hold unpushed work or an
	# untracked config.local.toml. Kept aside; the dotfiles' doctor flags it.
	[ ! -d "$dir/.git" ] || [ -e "$dir.pre-pin" ] || mv "$dir" "$dir.pre-pin"
	[ ! -e "$dir" ] || mv "$dir" "$dir.old"
	mv "$dir.new" "$dir" && rm -rf "$dir.old"
	echo "dotfiles: $ref at $dir"
}

run() {
	[ -f "$dir/scripts/pod-bootstrap" ] || { echo "dotfiles: no checkout at $dir; nothing to run"; return 1; }
	DOTFILES_REF="$ref" timeout 3300 sh "$dir/scripts/pod-bootstrap" "$env" ||
		echo "dotfiles: bootstrap did not complete; starting anyway"
}

case "$*" in
fetch) fetch ;;
run) run ;;
"") fetch; run ;;
*) echo "usage: dotfiles-bootstrap [fetch|run]" ;;
esac
exit 0
