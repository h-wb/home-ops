#!/bin/sh
# README.md. Always exits 0: the pod starts anyway. Flux substitutes the two
# variables below; nothing else here may use braces.
set -u
ref=${DOTFILES_REF}
env=${DOTFILES_ENV}
dir="$HOME/.dotfiles"
url=https://github.com/h-wb/dotfiles.git
state="$HOME/.local/state"
log="$state/dotfiles.log"
# The mise image's MISE_* point at /mise, not this home.
unset MISE_CONFIG_DIR MISE_DATA_DIR MISE_CACHE_DIR MISE_ENV
# A start must not dirty the checkout the next one moves.
export MISE_LOCKED=1
export PATH="/opt/mise/usr/local/bin:$HOME/.local/share/mise/shims:$PATH"
mkdir -p "$state"

fetch() {
	timeout 600 mise -E "$env" bootstrap --from "$url?ref=$ref" --update --from-dir "$dir" \
		--config-dir . --save-env --yes --only final-hook >>"$log" 2>&1 ||
		{ echo "dotfiles: fetch failed for $ref; see $log"; return 1; }
	echo "dotfiles: $ref at $dir"
}

run() {
	[ -d "$dir/.git" ] || { echo "dotfiles: no checkout at $dir; nothing to run"; return 1; }
	cd "$dir" || return 1
	DOTFILES_REF="$ref" timeout 3300 mise run apply --unattended >>"$log" 2>&1 ||
		echo "dotfiles: bootstrap did not complete; starting anyway"
	echo "dotfiles: $(cat "$state/dotfiles.status" 2>/dev/null || echo "no status"); log: $log"
}

case "$*" in
fetch) fetch ;;
run) run ;;
"") fetch; run ;;
*) echo "usage: dotfiles-bootstrap [fetch|run]" ;;
esac
exit 0
