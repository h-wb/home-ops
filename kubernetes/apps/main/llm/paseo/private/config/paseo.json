{
  "daemon": {
    "agentProfiles": [
      {
        "id": "plan",
        "name": "Plan",
        "provider": "mistral-vibe",
        "model": "mistral-large-4",
        "modeId": "ask",
        "notes": "Hard design or debugging questions: architecture, root causes, comparing approaches. Reads and reports; any other command waits for a yes."
      },
      {
        "id": "build",
        "name": "Build",
        "provider": "mistral-vibe",
        "model": "mistral-large-4",
        "modeId": "auto-approve",
        "notes": "A well-specified change: the goal, the files and the check to pass are already known. Not for open questions."
      },
      {
        "id": "review",
        "name": "Review",
        "provider": "mistral-vibe",
        "model": "glm-5.3",
        "modeId": "ask",
        "notes": "An independent read of a diff or a plan: correctness, missing tests, needless complexity. Reads only, and any other command waits for a yes. Runs on GLM, a different model family from the Plan and Build profiles."
      }
    ]
  },
  "agents": {
    "resumeOnStartup": true,
    "providers": {
      "opencode": {
        "enabled": true,
        "paseoTools": { "disabledTools": ["create_agent", "send_agent_prompt"] }
      },
      "claude": { "enabled": false },
      "codex": { "enabled": false },
      "mistral-vibe": {
        "extends": "acp",
        "label": "Mistral Vibe",
        "enabled": true,
        "command": ["vibe-acp"],
        "env": {
          "VIBE_MODELS": "[{\"name\":\"mistral-large-4\",\"provider\":\"mistral\",\"alias\":\"mistral-large-4\",\"display_name\":\"Mistral Large 4\"},{\"name\":\"zai-glm-5-3\",\"provider\":\"mistral\",\"alias\":\"glm-5.3\",\"display_name\":\"GLM 5.3\"}]"
        },
        "paseoTools": { "disabledTools": ["create_agent", "send_agent_prompt"] }
      },
      "copilot": { "enabled": false },
      "pi": { "enabled": false },
      "muse": { "enabled": false },
      "antigravity": { "enabled": false },
      "omp": { "enabled": false },
      "hermes-private": {
        "extends": "acp",
        "label": "Hermes (private)",
        "enabled": true,
        "command": [
          "mise",
          "exec",
          "aqua:kubernetes/kubectl@1.33.1",
          "--",
          "kubectl",
          "-n",
          "llm",
          "exec",
          "-i",
          "hermes-private-0",
          "-c",
          "hermes",
          "--",
          "/opt/hermes/.venv/bin/python",
          "/opt/hermes-acp/shim.py"
        ],
        "paseoTools": { "enabled": false }
      }
    },
    "metadataGeneration": {
      "providers": [{ "provider": "opencode" }]
    }
  }
}
