{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/mistral/mistral-medium-latest",
  "small_model": "litellm/mistral/mistral-small-latest",
  "enabled_providers": ["litellm"],
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://litellm.llm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "mistral/mistral-small-latest": {
          "name": "Mistral Small 4",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            }
          ]
        },
        "mistral/mistral-medium-latest": {
          "name": "Mistral Medium 3.5",
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            }
          ]
        },
        "mistral/mistral-large-latest": {
          "name": "Mistral Large 3",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "mistral/mistral-large-4": {
          "name": "Mistral Large 4",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "capabilities": {
            "input": ["text", "image"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          }
        },
        "mistral/zai-glm-5-3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "capabilities": {
            "input": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "high", "max"]
            }
          }
        },
        "mistral/zai-glm-5-3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 1048576,
            "output": 32768
          },
          "capabilities": {
            "reasoning": {
              "supported": true,
              "effort": ["low", "high", "max"]
            }
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "litellm/mistral/mistral-large-4"
    },
    "plan": {
      "model": "litellm/mistral/mistral-medium-latest#none"
    }
  }
}
