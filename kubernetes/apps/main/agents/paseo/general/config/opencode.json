{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/mistral-medium-latest",
  "small_model": "mistral/mistral-small-latest",
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://litellm.${SECRET_DOMAIN}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "chatgpt/gpt-6-astra": {
          "name": "GPT-6 Astra (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "chatgpt/gpt-6-luna": {
          "name": "GPT-6 Luna (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "chatgpt/gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "chatgpt/gpt-6.1-terra": {
          "name": "GPT-6.1 Terra (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    },
    "mistral": {
      "env": ["MISTRAL_API_KEY"],
      "models": {
        "mistral-large-latest": {
          "name": "Mistral Large 3"
        },
        "mistral-large-4": {
          "capabilities": { "reasoning": { "supported": true, "toggle": true } }
        },
        "mistral-medium-latest": {
          "name": "Mistral Medium 3.5",
          "capabilities": { "reasoning": { "supported": true, "toggle": true } }
        },
        "mistral-small-latest": {
          "name": "Mistral Small 4",
          "capabilities": { "reasoning": { "supported": true, "toggle": true } }
        },
        "zai-glm-5-3": {
          "capabilities": { "reasoning": { "supported": true, "toggle": true } }
        },
        "zai-glm-5-3-flash": {
          "capabilities": { "reasoning": { "supported": true, "toggle": true } }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "mistral/mistral-medium-latest#none"
    },
    "plan": {
      "model": "mistral/mistral-medium-latest#none"
    }
  },
  "mcp": {
    "servers": {
      "toolhive-general": {
        "type": "remote",
        "url": "https://mcp-general.${SECRET_DOMAIN}/mcp",
        "headers": { "x-api-key": "{env:MCP_API_KEY}" }
      },
      "memini-general": {
        "type": "remote",
        "url": "http://memini-general.llm.svc.cluster.local:8080/mcp",
        "headers": { "Authorization": "Bearer {env:MEMINI_API_KEY}" }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["chrome-devtools-mcp", "--browserUrl", "http://127.0.0.1:9222"]
      }
    }
  }
}
