{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/mistral-medium-latest",
  "small_model": "mistral/mistral-small-latest",
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://litellm.llm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "chatgpt/gpt-6-astra": {
          "name": "GPT-6 Astra (ChatGPT)",
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "chatgpt/gpt-6-luna": {
          "name": "GPT-6 Luna (ChatGPT)",
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "chatgpt/gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (ChatGPT)",
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "chatgpt/gpt-6.1-terra": {
          "name": "GPT-6.1 Terra (ChatGPT)",
          "limit": {
            "context": 272000,
            "output": 128000
          }
        },
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "mistral": {
      "env": ["MISTRAL_API_KEY"],
      "models": {
        "codestral-2508": {
          "disabled": true
        },
        "codestral-latest": {
          "disabled": true
        },
        "deepseek-v4-1-flash-1017": {
          "disabled": true
        },
        "devstral-2512": {
          "disabled": true
        },
        "devstral-latest": {
          "disabled": true
        },
        "devstral-medium-latest": {
          "disabled": true
        },
        "glm-5-2": {
          "disabled": true
        },
        "labs-devstral-small-2512": {
          "disabled": true
        },
        "labs-leanstral-1-5-1": {
          "disabled": true
        },
        "magistral-medium-latest": {
          "disabled": true
        },
        "ministral-14b-2512": {
          "disabled": true
        },
        "ministral-3b-2512": {
          "disabled": true
        },
        "ministral-3b-latest": {
          "disabled": true
        },
        "ministral-8b-2512": {
          "disabled": true
        },
        "ministral-8b-latest": {
          "disabled": true
        },
        "mistral-embed": {
          "disabled": true
        },
        "mistral-large-2512": {
          "disabled": true
        },
        "mistral-large-4-0-8": {
          "disabled": true
        },
        "mistral-medium-2505": {
          "disabled": true
        },
        "mistral-medium-2508": {
          "disabled": true
        },
        "mistral-medium-2604": {
          "disabled": true
        },
        "mistral-small-2506": {
          "disabled": true
        },
        "mistral-small-2603": {
          "disabled": true
        },
        "open-mistral-nemo": {
          "disabled": true
        },
        "pixtral-12b": {
          "disabled": true
        },
        "voxtral-mini-latest": {
          "disabled": true
        },
        "voxtral-mini-tts-latest": {
          "disabled": true
        },
        "voxtral-small-2507": {
          "disabled": true
        },
        "voxtral-small-latest": {
          "disabled": true
        },
        "zai-glm-5-2": {
          "disabled": true
        },
        "mistral-large-latest": {
          "name": "Mistral Large 3"
        },
        "mistral-large-4": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "mistral-medium-latest": {
          "name": "Mistral Medium 3.5",
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "mistral-small-latest": {
          "name": "Mistral Small 4",
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "zai-glm-5-3": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "zai-glm-5-3-flash": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "mistral/mistral-large-4"
    },
    "plan": {
      "model": "mistral/mistral-medium-latest#none"
    },
    "coordinator": {
      "mode": "primary",
      "model": "litellm/chatgpt/gpt-6-astra",
      "description": "Main agent: does bounded work itself, delegates research to explorer and risky-change review to reviewer.",
      "system": "You are the coordinator. Make understood, bounded changes yourself; delegation is optional, not your identity. Delegate only when an isolated context or independent parallel work clearly outweighs the handoff cost; never spawn agents to fill slots.\n\nCONTEXT: targeted searches and reads, not broad dumps. Hand off the objective, settled decisions, owned files, exclusions and the acceptance check, never a transcript. Ask workers for findings, changed paths and checks, not file dumps.\n\nVERIFICATION: inspect the diff and run the cheapest relevant check. Reuse passing evidence while nothing relevant changed. Distinguish measured results from assumptions.\n\nREVIEW GATE: decide from the changed behavior and its failure modes, not file type or diff size. Do understood low-risk work directly (prose, typos, formatting, mechanical renames, routine config) and self-verify. Ask the `reviewer` for one bounded independent review only for nontrivial behavior changes or real risk: permissions/auth, secret exposure, destructive storage or recovery, concurrency, CI enforcement. Give it the goal, the diff and relevant test facts, not your reasoning. Re-review only material fixes. Stop when acceptance is met.\n\nLANES: `explorer` (Mistral Small) for bounded read-only discovery when you are genuinely uncertain; `reviewer` (Mistral Large, a different model family) for the review gate. The ChatGPT quota is shared with other services: prefer Mistral lanes for bulk reading."
    },
    "explorer": {
      "mode": "subagent",
      "model": "mistral/mistral-large-4",
      "description": "Read-only reconnaissance: where/how is X, code search, mapping unfamiliar code. Returns findings and paths, not dumps.",
      "system": "You explore and report; you never modify files. Answer the question asked with file paths, line references and the minimum evidence. Say plainly what you could not find.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "model": "mistral/zai-glm-5-3",
      "description": "Independent adversarial review of a substantive or risky change. Reports concrete defects and missing coverage.",
      "system": "Assume the change is broken and try to prove it. For each changed boundary, trace inherited authority and configuration, failure and cleanup paths, and construct a concrete failure scenario before calling anything safe. Report only concrete defects and missing coverage, most severe first, each with the input or state that triggers it. No style nits, no unrequested polish.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "permission": "allow",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000
    },
    "buffer": 16384
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 16384
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "opencode-go",
      "effect": "deny"
    }
  ]
}
