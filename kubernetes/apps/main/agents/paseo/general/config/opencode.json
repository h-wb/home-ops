{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/mistral/mistral-medium-latest",
  "small_model": "litellm/mistral/mistral-small-latest",
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.${SECRET_DOMAIN}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "chatgpt/gpt-6-astra": {
          "name": "GPT-6 Astra (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "chatgpt/gpt-6-luna": {
          "name": "GPT-6 Luna (ChatGPT)",
          "limit": { "context": 272000, "output": 128000 }
        },
        "mistral/mistral-large-latest": { "name": "Mistral Large" },
        "mistral/mistral-medium-latest": { "name": "Mistral Medium" },
        "mistral/mistral-small-latest": { "name": "Mistral Small" },
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "toolhive-general": {
      "type": "remote",
      "url": "https://mcp-general.${SECRET_DOMAIN}/mcp",
      "headers": { "x-api-key": "{env:MCP_API_KEY}" }
    },
    "memini-general": {
      "type": "remote",
      "url": "http://memini-general.llm.svc.cluster.local:8080/mcp",
      "headers": { "Authorization": "Bearer {env:MEMINI_API_KEY}" }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["chrome-devtools-mcp", "--browserUrl", "http://127.0.0.1:9222"]
    }
  }
}
