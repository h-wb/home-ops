{
  "agents": {
    "resumeOnStartup": true,
    "providers": {
      "opencode": {
        "enabled": true,
        "paseoTools": { "disabledTools": ["create_agent", "send_agent_prompt"] }
      },
      "claude": { "enabled": false },
      "codex": { "enabled": false },
      "mistral-vibe": { "enabled": false },
      "copilot": { "enabled": false },
      "pi": { "enabled": false },
      "muse": { "enabled": false },
      "antigravity": { "enabled": false },
      "omp": { "enabled": false },
      "hermes-private": {
        "extends": "acp",
        "label": "Hermes (private)",
        "enabled": true,
        "command": [
          "mise",
          "exec",
          "aqua:kubernetes/kubectl@1.33.1",
          "--",
          "kubectl",
          "-n",
          "llm",
          "exec",
          "-i",
          "hermes-private-0",
          "-c",
          "hermes",
          "--",
          "/opt/hermes/.venv/bin/python",
          "/opt/hermes-acp/shim.py"
        ],
        "paseoTools": { "enabled": false }
      }
    },
    "metadataGeneration": {
      "providers": [{ "provider": "opencode" }]
    }
  }
}
