{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/mistral-medium-latest",
  "small_model": "mistral/mistral-small-latest",
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://litellm.${SECRET_DOMAIN}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "mistral": {
      "env": ["MISTRAL_API_KEY"],
      "models": {
        "codestral-2508": {
          "disabled": true
        },
        "codestral-latest": {
          "disabled": true
        },
        "deepseek-v4-1-flash-1017": {
          "disabled": true
        },
        "devstral-2512": {
          "disabled": true
        },
        "devstral-latest": {
          "disabled": true
        },
        "devstral-medium-latest": {
          "disabled": true
        },
        "glm-5-2": {
          "disabled": true
        },
        "labs-devstral-small-2512": {
          "disabled": true
        },
        "labs-leanstral-1-5-1": {
          "disabled": true
        },
        "magistral-medium-latest": {
          "disabled": true
        },
        "ministral-14b-2512": {
          "disabled": true
        },
        "ministral-3b-2512": {
          "disabled": true
        },
        "ministral-3b-latest": {
          "disabled": true
        },
        "ministral-8b-2512": {
          "disabled": true
        },
        "ministral-8b-latest": {
          "disabled": true
        },
        "mistral-embed": {
          "disabled": true
        },
        "mistral-large-2512": {
          "disabled": true
        },
        "mistral-large-4-0-8": {
          "disabled": true
        },
        "mistral-medium-2505": {
          "disabled": true
        },
        "mistral-medium-2508": {
          "disabled": true
        },
        "mistral-medium-2604": {
          "disabled": true
        },
        "mistral-small-2506": {
          "disabled": true
        },
        "mistral-small-2603": {
          "disabled": true
        },
        "open-mistral-nemo": {
          "disabled": true
        },
        "pixtral-12b": {
          "disabled": true
        },
        "voxtral-mini-latest": {
          "disabled": true
        },
        "voxtral-mini-tts-latest": {
          "disabled": true
        },
        "voxtral-small-2507": {
          "disabled": true
        },
        "voxtral-small-latest": {
          "disabled": true
        },
        "zai-glm-5-2": {
          "disabled": true
        },
        "mistral-large-latest": {
          "name": "Mistral Large 3"
        },
        "mistral-large-4": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "mistral-medium-latest": {
          "name": "Mistral Medium 3.5",
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "mistral-small-latest": {
          "name": "Mistral Small 4",
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "zai-glm-5-3": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        },
        "zai-glm-5-3-flash": {
          "capabilities": {
            "reasoning": {
              "supported": true,
              "toggle": true
            }
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "mistral/mistral-medium-latest#none"
    },
    "plan": {
      "model": "mistral/mistral-medium-latest#none"
    }
  },
  "mcp": {
    "servers": {
      "toolhive-private": {
        "type": "remote",
        "url": "https://mcp-private.${SECRET_DOMAIN}/mcp",
        "headers": {
          "x-api-key": "{env:MCP_API_KEY}"
        }
      }
    }
  }
}
