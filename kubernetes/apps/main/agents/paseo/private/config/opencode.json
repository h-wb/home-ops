{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/mistral-medium-latest",
  "small_model": "mistral/mistral-small-latest",
  "enabled_providers": ["litellm", "mistral"],
  "agents": {
    "build": {
      "model": "mistral/mistral-medium-latest",
      "variant": "none"
    },
    "plan": {
      "model": "mistral/mistral-medium-latest",
      "variant": "none"
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.${SECRET_DOMAIN}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    },
    "mistral": {
      "options": {
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "whitelist": ["mistral-large-latest", "mistral-medium-latest", "mistral-small-latest"],
      "models": {
        "mistral-medium-latest": {
          "name": "Mistral Medium 3.5",
          "reasoning": { "supported": true, "toggle": true }
        },
        "mistral-small-latest": {
          "name": "Mistral Small 4",
          "reasoning": { "supported": true, "toggle": true }
        }
      }
    }
  },
  "mcp": {
    "toolhive-private": {
      "type": "remote",
      "url": "https://mcp-private.${SECRET_DOMAIN}/mcp",
      "headers": { "x-api-key": "{env:MCP_API_KEY}" }
    }
  }
}
