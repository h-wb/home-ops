---
machine:
  network:
    hostname: "tal1s"
    interfaces:
      - deviceSelector:
          hardwareAddr: "48:21:0b:3c:20:ce"
        dhcp: true
        mtu: 1500
        addresses:
          - 192.168.1.191/24
        routes:
          - network: "0.0.0.0/0"
            gateway: "192.168.1.1"
        vip:
          ip: "192.168.1.253"
#  nodeLabels:
#   topology.kubernetes.io/zone: m
  sysctls:
    # Yama 2 -> 1 for the OpenShell prototype (kubernetes/apps/main/proto), which pins its
    # sandboxes here. The supervisor reads its workload child's memory with all capabilities
    # dropped, which Talos's default of 2 (CAP_SYS_PTRACE only) refuses. Scope 1 allows reading
    # only one's own descendants (Ubuntu/Debian default); siblings and other containers stay
    # blocked. Remove with the prototype. Sysctls apply live, without a reboot.
    kernel.yama.ptrace_scope: "1"
  type: controlplane
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp100s0
rings:
  # default 256 overflows under bursts (rx_missed_errors)
  rx: 4096
