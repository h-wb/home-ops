---
machine:
  network:
    hostname: "tal2s"
    interfaces:
      - deviceSelector:
          hardwareAddr: "48:21:0b:3c:20:dc"
        dhcp: true
        mtu: 1500
        addresses:
          - 192.168.1.192/24
        routes:
          - network: "0.0.0.0/0"
            gateway: "192.168.1.1"
        vip:
          ip: "192.168.1.253"
#  nodeLabels:
#   topology.kubernetes.io/zone: m
  type: controlplane
---
apiVersion: v1alpha1
kind: EthernetConfig
name: enp86s0
rings:
  # default 256 overflows under bursts (rx_missed_errors)
  rx: 4096
